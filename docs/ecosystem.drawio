<mxfile host="app.diagrams.net"><diagram name="IngeTrazo-Repos" id="d1"><mxGraphModel dx="1600" dy="960" grid="1" gridSize="10" page="1" pageWidth="1620" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style='font-size:20px'&gt;IngeTrazo – Repositories, Users &amp;amp; Features (as of 2026-11-28)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1560" height="40" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;AI clients&lt;/b&gt;&lt;br&gt;Claude, Cursor, VS Code …" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="300" height="60" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Browser users &amp;amp; admins&lt;/b&gt;&lt;br&gt;users, guests, access links" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="70" width="300" height="60" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Desktop users&lt;/b&gt;&lt;br&gt;Linux / Windows / macOS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="70" width="320" height="60" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Browser users (Félix' web app)&lt;/b&gt;&lt;br&gt;model directly in the browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1260" y="70" width="320" height="60" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style='font-size:15px'&gt;BastelBaus/ingetrazo-web-viewer&lt;/b&gt; · gateway + frontend · AGPL-3.0&lt;br&gt;&lt;i&gt;ghcr.io/bastelbaus/ingetrazo-web-viewer · &lt;b&gt;no IngeTrazo inside&lt;/b&gt; · not released yet (:dev)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;arcSize=3;" vertex="1" parent="1"><mxGeometry x="30" y="180" width="690" height="300" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style='font-size:14px'&gt;Service &lt;code&gt;mcp&lt;/code&gt; – MCP gateway&lt;/b&gt;&lt;br&gt;&lt;i&gt;for AI clients&lt;/i&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;&lt;b&gt;Auth: token or OAuth 2.1&lt;/b&gt; (claude.ai connector)&lt;/li&gt;&lt;li&gt;&lt;b&gt;personal MCP tokens&lt;/b&gt; per user&lt;/li&gt;&lt;li&gt;&lt;b&gt;per-user folder rights&lt;/b&gt;&lt;/li&gt;&lt;li&gt;adds list_documents, hides shutdown&lt;/li&gt;&lt;li&gt;run_python blocked for normal users&lt;/li&gt;&lt;li&gt;forwards MCP to &lt;code&gt;mcp-engine&lt;/code&gt;&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=4;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="45" y="240" width="320" height="225" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b style='font-size:14px'&gt;Service &lt;code&gt;viewer&lt;/code&gt; – web viewer + admin&lt;/b&gt;&lt;br&gt;&lt;i&gt;for browser users&lt;/i&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;&lt;b&gt;live read-only viewer: sheets, views, 3D&lt;/b&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;render queue + cache&lt;/b&gt;, auto-refresh&lt;/li&gt;&lt;li&gt;&lt;b&gt;login: local / OIDC / proxy&lt;/b&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;users, roles, folder shares&lt;/b&gt;&lt;/li&gt;&lt;li&gt;guest login, expiring access links&lt;/li&gt;&lt;li&gt;&lt;b&gt;audit log&lt;/b&gt; · i18n EN/DE pending&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=4;strokeWidth=2;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="240" width="325" height="225" as="geometry"/></mxCell><mxCell id="c10" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;arcSize=3;" vertex="1" parent="1"><mxGeometry x="30" y="540" width="690" height="290" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b style='font-size:15px'&gt;BastelBaus/ingetrazo-docker&lt;/b&gt; · engine · AGPL-3.0 · v0.2.0&lt;br&gt;&lt;i&gt;ghcr.io/bastelbaus/ingetrazo · &lt;b&gt;IngeTrazo headless&lt;/b&gt; (Xvfb + Mesa, no GPU)&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="40" y="545" width="670" height="50" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b style='font-size:14px'&gt;&lt;code&gt;mcp-engine&lt;/code&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;ENGINE_MODE=mcp&lt;/i&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;&lt;b&gt;all tools&lt;/b&gt; except shutdown&lt;/li&gt;&lt;li&gt;open/save only under /data&lt;/li&gt;&lt;li&gt;save only with ALLOW_SAVE&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=4;strokeWidth=2;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="45" y="600" width="320" height="135" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b style='font-size:14px'&gt;&lt;code&gt;viewer-engine&lt;/code&gt; (1…n workers)&lt;/b&gt;&lt;br&gt;&lt;i&gt;ENGINE_MODE=render&lt;/i&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;&lt;b&gt;render only, never saves&lt;/b&gt;&lt;/li&gt;&lt;li&gt;reads /data, writes /cache&lt;/li&gt;&lt;li&gt;build in /healthz → re-render&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=4;strokeWidth=2;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="380" y="600" width="325" height="135" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Internal HTTP API :8766&lt;/b&gt; – internal network only, service token&lt;br&gt;POST /call · POST /rpc (mcp) · GET /healthz&lt;br&gt;unprivileged user · .igz optionally as plain JSON (git diffs)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;dashed=1;" vertex="1" parent="1"><mxGeometry x="45" y="745" width="660" height="70" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Volumes&lt;/b&gt;: /data (model folders, ro/rw) · /cache · /state · users (SQLite)&lt;br&gt;Files: .igz, IFC, PDF · &lt;i&gt;planned: plan versioning in Gitea&lt;/i&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="880" width="690" height="55" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b style='font-size:14px'&gt;ingelibre/ingetrazo&lt;/b&gt;&lt;br&gt;&lt;i&gt;upstream · desktop app · GPL-3.0 · M. Sumari Tellez + community&lt;/i&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;&lt;b&gt;3D modelling&lt;/b&gt;: push/pull, offset, follow-me, booleans&lt;/li&gt;&lt;li&gt;groups, components, layers, scenes, sections&lt;/li&gt;&lt;li&gt;&lt;b&gt;sheet composer → vector PDF / DXF&lt;/b&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;BIM: IFC classes + IFC export&lt;/b&gt;&lt;/li&gt;&lt;li&gt;georef: UTM, basemaps, terrain&lt;/li&gt;&lt;li&gt;&lt;b&gt;import .skp&lt;/b&gt;, STL, OBJ, DAE, DWG&lt;/li&gt;&lt;li&gt;export .igz, glTF, IFC, PDF, DXF …&lt;/li&gt;&lt;li&gt;&lt;b&gt;AI Bridge (MCP)&lt;/b&gt; + AI assistant, plugins&lt;/li&gt;&lt;li&gt;Python / PySide6 (Qt 6)&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=4;strokeWidth=2;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="900" y="180" width="320" height="360" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b style='font-size:14px'&gt;Fork BastelBaus/ingetrazo&lt;/b&gt;&lt;br&gt;&lt;i&gt;branch deploy/docker · &lt;b&gt;temporary&lt;/b&gt;&lt;/i&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;upstream main + own open PRs&lt;/li&gt;&lt;li&gt;&lt;b&gt;for testing / backup only&lt;/b&gt;&lt;/li&gt;&lt;li&gt;dropped once all PRs are merged (#1717)&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=4;strokeWidth=2;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1"><mxGeometry x="900" y="650" width="320" height="110" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b style='font-size:14px'&gt;felixriestra/ingetrazo-web-open&lt;/b&gt;&lt;br&gt;&lt;i&gt;„IngeTrazo Web“ · Félix Riestra · GPL-3.0 · &lt;b&gt;standalone&lt;/b&gt;&lt;/i&gt;&lt;ul style='margin:4px 0 0 0;padding-left:16px'&gt;&lt;li&gt;&lt;b&gt;full modelling in the browser&lt;/b&gt;&lt;/li&gt;&lt;li&gt;FastAPI server + Three.js client&lt;/li&gt;&lt;li&gt;&lt;b&gt;own pruned copy of the engine&lt;/b&gt;&lt;/li&gt;&lt;li&gt;doors/windows, terrain, IFC4 + quantities&lt;/li&gt;&lt;li&gt;sheets + vector PDF&lt;/li&gt;&lt;li&gt;&lt;b&gt;every edit = revision&lt;/b&gt; (undo/restore)&lt;/li&gt;&lt;li&gt;files only, no DB; optional accounts&lt;/li&gt;&lt;li&gt;own MCP server, 21 languages&lt;/li&gt;&lt;li&gt;&lt;b&gt;not integrated in ArchPlan&lt;/b&gt;&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;arcSize=4;strokeWidth=2;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1260" y="180" width="320" height="420" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Legend&lt;/b&gt;: &lt;span style='color:#6c8ebf'&gt;■&lt;/span&gt; gateway/frontend · &lt;span style='color:#82b366'&gt;■&lt;/span&gt; engine · &lt;span style='color:#d79b00'&gt;■&lt;/span&gt; upstream IngeTrazo · &lt;span style='color:#9673a6'&gt;■&lt;/span&gt; Félix' web edition · dashed = temporary&lt;br&gt;&lt;br&gt;&lt;b&gt;Test deployment:&lt;/b&gt; Komodo stacks ingetrazo, ingetrazo-rc, ingetrazo-dev on truenas-bastelbaus (:dev)&lt;br&gt;&lt;b&gt;Next:&lt;/b&gt; web-viewer release · engine on upstream release after #1717 · viewer i18n EN/DE" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="900" y="790" width="680" height="145" as="geometry"/></mxCell><mxCell id="c20" value="MCP over HTTPS&lt;br&gt;token / OAuth" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeWidth=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="HTTPS · login" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeWidth=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="POST /rpc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeWidth=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="POST /call" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeWidth=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c9" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="desktop app" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeWidth=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeWidth=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Docker build from upstream&lt;/b&gt;&lt;br&gt;release tag (target)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeWidth=2;labelBackgroundColor=#ffffff;strokeColor=#d79b00;exitX=0;exitY=0.85;entryX=1;entryY=0.25;" edge="1" parent="1" source="c16" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="main + PRs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeWidth=2;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#d6b656;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="testing / backup&lt;br&gt;(INGETRAZO_REF)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeWidth=2;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#d6b656;exitX=0;exitY=0.5;entryX=1;entryY=0.75;" edge="1" parent="1" source="c17" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="copy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeWidth=2;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;" edge="1" parent="1" source="c16" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="/data · /cache" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;endArrow=block;strokeWidth=2;labelBackgroundColor=#ffffff;strokeColor=#d6b656;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>