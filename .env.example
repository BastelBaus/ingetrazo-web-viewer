# Copy to .env and adjust. Every value is optional unless noted.

# ---- Images ---------------------------------------------------------------
# The engines (IngeTrazo headless; BastelBaus/ingetrazo-docker) and this
# repo's image (gateway and viewer). Pin both to matching tags in production.
# INGETRAZO_IMAGE=ghcr.io/bastelbaus/ingetrazo:latest
# WEB_VIEWER_IMAGE=ghcr.io/bastelbaus/ingetrazo-web-viewer:latest
# WEB_VIEWER_REF=<this repo's tag or commit for a local build, shown in the footer>

# ---- Models -----------------------------------------------------------------
# Host folder with your .igz files (mounted at /data in the containers).
INGETRAZO_DATA_DIR=./data
# Several model folders instead, each at /data/<name> (bind mounts: see
# compose.folders.example.yaml). Entries separated by ";":
#   name[:rw|ro][:depth=N][:exclude=glob,glob]
# ro: the MCP service may not save or export into it. depth: 0 = the folder
# itself only. exclude: names (*.bak.igz, archive*) or paths (old/**) left
# out of the listing. Empty: one read/write folder, /data, named "data".
# MODEL_FOLDERS=projects:rw; archive:ro:depth=1:exclude=old*,*.bak.igz
MODEL_FOLDERS=
# Defaults for every folder: how deep to look (empty: no limit), and what
# to leave out (comma-separated globs).
MODEL_SCAN_DEPTH=
MODEL_EXCLUDE=
# Document to open at start (relative to the data folder). Empty: none.
INGETRAZO_MODEL=
# Let MCP clients save (save_document). Paths are confined to /data.
INGETRAZO_ALLOW_SAVE=true
# "json" saves plain-JSON .igz (diffable in git); empty: as the app does.
INGETRAZO_SAVE_FORMAT=

# ---- MCP server ---------------------------------------------------------------
# Interface the port is published on. 127.0.0.1 = this machine only;
# 0.0.0.0 = the network (then use token or oauth, and TLS in front).
MCP_BIND=127.0.0.1
MCP_PORT=8765
# none | token | oauth   (run_python executes arbitrary Python in the container)
MCP_AUTH=token
# MCP_AUTH=token: a token with every right, at least 16 characters (openssl rand
# -hex 32). Optional when users use their personal tokens (viewer: /account).
MCP_TOKEN=
# Public https URL of this server (required for oauth, e.g. behind Caddy).
PUBLIC_URL=
# oauth: the one user who may approve clients (password: 12+ characters), and
# the redirect URIs clients may register (comma-separated; same scheme and
# host, path as prefix; a loopback host without port takes any port).
# Default: claude.ai and claude.com callbacks, http://localhost, http://127.0.0.1
OAUTH_USER=admin
OAUTH_PASSWORD=
OAUTH_REDIRECT_URIS=
# Token lifetimes (default 3600 s and 30 days).
OAUTH_ACCESS_TOKEN_SECONDS=
OAUTH_REFRESH_TOKEN_DAYS=

# ---- Viewer (docker compose --profile viewer up) ------------------------------
VIEWER_BIND=127.0.0.1
VIEWER_PORT=8080
# Who may see the viewer: local | none | oidc | proxy  (README: "Viewer login")
#   local  users with a password, managed at /admin; ADMIN_USER / ADMIN_PASSWORD
#          make the first admin (required until there is one)
#   none   no login at all, on purpose
#   oidc   OpenID Connect (Authentik, Keycloak, ...)
#   proxy  a reverse proxy with forward auth names the user in a header
VIEWER_AUTH_MODE=local
ADMIN_USER=admin
ADMIN_PASSWORD=
# local / oidc: a "Log in as guest" button; the guest user can be switched off
# in the admin panel (/admin).
VIEWER_GUEST=false
# The folders of a user an admin has not given any (in /admin → Folders):
# path:access; …  with r, rw or none; * = every folder. A path can be a
# pattern: * within one folder name, ? one character, ** any number of
# folders, e.g. *:r; **/private:none; **/*.bak.igz:none. The most specific
# share wins (see "Folder patterns" in the README).
DEFAULT_SHARES=*:r
# oidc: the provider's issuer URL, the client, and https://<viewer>/auth/callback
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
# Optional: default "openid profile email"; members of this group are admins.
OIDC_SCOPES=
OIDC_ADMIN_GROUP=
# proxy: the proxy's address(es)/networks (required), its headers, admin group,
# and where Log out goes (Authentik: /outpost.goauthentik.io/sign_out).
PROXY_TRUSTED_IPS=
PROXY_USER_HEADER=X-authentik-username
PROXY_GROUPS_HEADER=
PROXY_ADMIN_GROUP=
PROXY_LOGOUT_URL=
# The headline; an admin can change it at /admin (kept in /state/site.json).
VIEWER_TITLE=IngeTrazo-docker
# What the viewer renders before anyone looks (the rest when it is opened):
#   previews  one small preview per model, for the overview (default)
#   none      nothing; previews when the overview is opened
#   all       every view, sheet, 3D model and PDF (fine for a few small models)
VIEWER_PRERENDER=previews
# The viewer renders through IngeTrazo in a container of its own
# (viewer-engine, on an internal network). Their shared secret is made on the
# first start; set one here to choose it yourself (openssl rand -hex 32).
ENGINE_TOKEN=
# The same for the MCP gateway and its engine (mcp-engine).
MCP_ENGINE_TOKEN=
# Several engines render side by side: add viewer-engine-2, ... services
# (compose.override.yaml) and list them all. Each is a whole IngeTrazo
# (memory, a few seconds to start); in software rendering more only help
# with free CPU cores.
#ENGINE_URLS=http://viewer-engine:8766,http://viewer-engine-2:8766
VIEWER_SHEET_DPI=120
# The View / 3D / Sheet dropdowns: tree (one level at a time, the default) or
# list (all folder levels). Each browser can switch in the dropdown.
VIEWER_NAV_MODE=tree
# The 3D view: models whose GLB is bigger than this get none (0 = no 3D view).
VIEWER_GLB_MAX_MB=50

# ---- Audit log (/admin -> Log) --------------------------------------------------
# Who opened what, logins, admin changes and errors, in /state/audit.log.
#VIEWER_AUDIT=true
#VIEWER_AUDIT_DAYS=90
#VIEWER_AUDIT_MAX_MB=10
#VIEWER_AUDIT_KEEP=5
# Behind a reverse proxy: its address, so the log shows the real client (and
# the login limit below counts per real client, not for all at once).
#VIEWER_TRUSTED_PROXIES=192.168.1.208

# ---- Hardening -------------------------------------------------------------------
# Wrong passwords/access links per address before it must wait (0 = no limit).
#VIEWER_LOGIN_LIMIT=10
#VIEWER_LOGIN_WINDOW=900
# Who may show the viewer in a frame: unset = only the viewer itself; origins
# such as https://ha.example.org; none; * (anyone).
#VIEWER_FRAME_ANCESTORS=
# The largest MCP request the gateway reads, in MB.
#MCP_MAX_BODY_MB=16

# ---- Slow hosts (software rendering, big models) -------------------------------
# Seconds one call may hold IngeTrazo before it answers "timed out on the UI
# thread" (app default 180). Exporting the sheets of a large model in software
# can take longer. Needs an IngeTrazo with ingelibre/ingetrazo#1586.
INGETRAZO_AI_TIMEOUT=
# MCP /healthz reports "blocked" (503) after a call ran this long (default 900).
HEALTH_MAX_BUSY_SECONDS=
# Virtual screen of the in-memory X server (default 2560x1600x24).
XVFB_SCREEN=
